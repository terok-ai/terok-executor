# syntax=docker/dockerfile:1
#
# L0 — base dev image shared by every terok project.
#
# Identical image content under both supported OCI runtimes (``crun``
# and ``krun``).  Under krun, ``init-ssh-and-repo.sh`` launches a
# rootless sshd on TCP 2222 (gated by ``TEROK_CONTAINER_RUNTIME=krun``
# from terok), reachable from the host via the per-task port that
# podman's passt has forwarded into the guest namespace
# (``ssh -p <host_port> dev@127.0.0.1``).  Under crun the gate is
# false and sshd never starts — ``podman exec`` does the talking
# instead.
#
# Rootless sshd because libkrun mounts the guest rootfs via virtiofs
# with ``nosuid``, so ``sudo`` can't elevate (exec'ing setuid /usr/bin/sudo
# fails with EACCES, observed on libkrun 1.17).  Sshd therefore runs as
# the ``dev`` user, with per-user host keys + config under
# ``/home/dev/.ssh/sshd_host/`` and ``/home/dev/.config/sshd/`` that
# the user can actually read and write.  Port 2222 because uid 1000
# can't bind < 1024 without ``CAP_NET_BIND_SERVICE``, which the keep-id
# user namespace doesn't carry; the host-side ``-p`` mapping hides this
# from the operator.

ARG BASE_IMAGE={{ BASE_IMAGE }}
FROM ${BASE_IMAGE}

ENV {% if family == "deb" %}DEBIAN_FRONTEND=noninteractive \
    {% endif %}REPO_ROOT="/workspace" \
    GIT_RESET_MODE="none" \
    LANG="en_US.UTF-8" \
    LC_ALL="en_US.UTF-8" \
    LANGUAGE="en_US:en" \
    USER="dev"

# Basic dev tooling common to all projects.  ``tzdata`` is explicit on
# both families so the runtime ``TZ`` env var — set from the host's
# timezone — can resolve against ``/usr/share/zoneinfo``.
# ``openssh-server`` is included so the krun-mode sshd path works;
# under crun it's inert.  ``socat`` is used by the in-container bridge
# scripts (SSH agent forwarding, vault loopback) regardless of runtime.
{% if family == "deb" -%}
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg git locales openssh-client openssh-server \
      socat sudo ripgrep vim tmux tzdata \
    && rm -rf /var/lib/apt/lists/*

# Ensure en_US.UTF-8 exists so bash and agent-spawned shells can always set LC_ALL safely.
RUN set -eux; \
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen; \
    grep -q '^en_US.UTF-8 UTF-8' /etc/locale.gen || echo 'en_US.UTF-8 UTF-8' >> /etc/locale.gen; \
    locale-gen en_US.UTF-8
{%- else -%}
# glibc-langpack-en provides en_US.UTF-8 directly — no locale-gen step needed.
RUN dnf install -y --setopt=install_weak_deps=False \
      ca-certificates curl gnupg2 git glibc-langpack-en openssh-clients openssh-server \
      socat sudo ripgrep vim tmux tzdata \
    && dnf clean all
{%- endif %}

RUN set -eux; \
    uid_owner="$(getent passwd 1000 | cut -d: -f1 || true)"; \
    if [ -n "$uid_owner" ] && [ "$uid_owner" != "dev" ]; then \
      if getent group "$uid_owner" >/dev/null; then groupmod -n dev "$uid_owner" || true; fi; \
      usermod -l dev "$uid_owner"; \
      usermod -d /home/dev -m dev; \
      # usermod -l / groupmod -n don't touch /etc/sub{u,g}id; rewrite \
      # those entries so pre-configured rootless ranges (e.g. the podman \
      # image's `podman:100000:65536`) keep working under the new name. \
      for f in /etc/subuid /etc/subgid; do \
        [ -f "$f" ] && sed -i "s/^${uid_owner}:/dev:/" "$f"; \
      done; \
    fi; \
    if ! getent group dev >/dev/null; then \
      groupadd dev; \
    fi; \
    if ! id -u dev >/dev/null 2>&1; then \
      useradd -m -u 1000 -g dev -s /bin/bash dev; \
    fi; \
    if [ "$(id -u dev)" != "1000" ]; then usermod -u 1000 dev; fi; \
    echo 'dev ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/dev; \
    chmod 0440 /etc/sudoers.d/dev; \
    visudo -cf /etc/sudoers.d/dev; \
{% if family == "rpm" %}    if [ "$(stat -c '%a' /etc/shadow)" = "0" ]; then \
        printf '%s\n' '#%PAM-1.0' \
            'auth sufficient pam_succeed_if.so ruser = dev' \
            'auth include system-auth' \
            'account sufficient pam_succeed_if.so ruser = dev' \
            'account include system-auth' \
            'password include system-auth' \
            'session include system-auth' \
            > /etc/pam.d/sudo; \
    fi; \
{% endif %}    mkdir -p /workspace /home/dev/.ssh; \
    chown -R dev:dev /home/dev /workspace; \
    chmod 700 /home/dev/.ssh; \
    chmod 0777 /workspace

# ── sshd-on-TCP-2222 (rootless): config + host keys owned by dev ──────────
#
# Pubkey-only sshd hardened down to the single ``dev`` account, no
# forwarding of any kind.  Lives under ``/home/dev/`` so the unprivileged
# ``dev`` user can read every file at launch — under krun there is no
# sudo to escalate.
#
# Trust file at ``/etc/ssh/authorized_keys.d/terok`` ships **empty** —
# the live host pubkey is bind-mounted in at task launch by terok, so
# the L0 image never carries a per-installation secret.  Mode 0644 so
# dev can read it through the bind-mount.
#
# Host key is generated at build time (under ``dev``, ed25519, no
# passphrase) into ``/home/dev/.ssh/sshd_host/`` so dev can read it at
# launch.  Shared host keys across containers built from one L0 are
# acceptable: clients use ``StrictHostKeyChecking=no`` +
# ``UserKnownHostsFile=/dev/null``, and the per-task host port is
# loopback-bound (experimental-runtime tradeoff).
RUN install -d -m 0755 /etc/ssh/authorized_keys.d \
    && : > /etc/ssh/authorized_keys.d/terok \
    && chmod 0644 /etc/ssh/authorized_keys.d/terok \
    && install -d -m 0700 -o dev -g dev /home/dev/.ssh/sshd_host \
    && install -d -m 0700 -o dev -g dev /home/dev/.config/sshd \
    && su -s /bin/sh dev -c \
        "ssh-keygen -q -t ed25519 -N '' -C '' -f /home/dev/.ssh/sshd_host/ssh_host_ed25519_key" \
    && printf '%s\n' \
        '# terok sshd — rootless, pubkey-only, single account.' \
        'Port 2222' \
        'HostKey /home/dev/.ssh/sshd_host/ssh_host_ed25519_key' \
        'PidFile /tmp/sshd-terok.pid' \
        'PermitRootLogin no' \
        'PasswordAuthentication no' \
        'PermitEmptyPasswords no' \
        'KbdInteractiveAuthentication no' \
        'PubkeyAuthentication yes' \
        'AllowUsers dev' \
        'AllowAgentForwarding no' \
        'AllowTcpForwarding no' \
        'X11Forwarding no' \
        'PermitTunnel no' \
        'GatewayPorts no' \
        'UsePAM no' \
        'AuthorizedKeysFile /etc/ssh/authorized_keys.d/terok' \
        > /home/dev/.config/sshd/config \
    && chown dev:dev /home/dev/.config/sshd/config \
    && chmod 0600 /home/dev/.config/sshd/config

WORKDIR /workspace

COPY scripts/init-ssh-and-repo.sh /usr/local/bin/init-ssh-and-repo.sh
COPY scripts/ssh-agent-bridge.sh /usr/local/bin/ssh-agent-bridge.sh
COPY scripts/ensure-bridges.sh /usr/local/bin/ensure-bridges.sh
RUN chmod +x /usr/local/bin/init-ssh-and-repo.sh /usr/local/bin/ssh-agent-bridge.sh /usr/local/bin/ensure-bridges.sh

# tmux config for persistent login sessions (prefix ^a, green status bar)
COPY tmux/container-tmux.conf /etc/tmux.conf

ENV HOME=/home/dev
USER dev
CMD ["init-ssh-and-repo.sh"]
